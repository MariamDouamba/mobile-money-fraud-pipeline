digraph MCD {
  rankdir=LR;
  graph [fontname="Helvetica", bgcolor="white", nodesep=0.6, ranksep=0.9, pad=0.3];
  edge [fontname="Helvetica", fontsize=10, arrowhead=none, color="#534AB7", penwidth=1.3, labeldistance=2.2, labelangle=0];

  COMPTE [shape=plaintext, label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7">
      <TR><TD BGCOLOR="#534AB7"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>COMPTE</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#EEEDFE"><FONT POINT-SIZE="10"><U>compte_pseudo</U></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">categorie</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">region</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">date_ouverture</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">statut</FONT></TD></TR>
    </TABLE>>];

  TRANSACTION [shape=plaintext, label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7">
      <TR><TD BGCOLOR="#0F6E56"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>TRANSACTION</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#E1F5EE"><FONT POINT-SIZE="10"><U>transaction_id</U></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">horodatage</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">type_operation</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">montant</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">devise</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">solde_emetteur_avant</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">solde_emetteur_apres</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">solde_destinataire_avant</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">solde_destinataire_apres</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">est_fraude</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">signale_existant</FONT></TD></TR>
    </TABLE>>];

  EVENEMENT [shape=plaintext, label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7">
      <TR><TD BGCOLOR="#C2660A"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>EVENEMENT_TECHNIQUE</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#FBF0E1"><FONT POINT-SIZE="10"><U>evenement_id</U></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">horodatage</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">canal</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">code_retour</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">latence_ms</FONT></TD></TR>
    </TABLE>>];

  EMETTRE [shape=box, style="filled,rounded", fillcolor="#EEEDFE", color="#534AB7",
           fontname="Helvetica", fontsize=11, label="ÉMETTRE", height=0.45, width=1.25];
  RECEVOIR [shape=box, style="filled,rounded", fillcolor="#EEEDFE", color="#534AB7",
            fontname="Helvetica", fontsize=11, label="RECEVOIR", height=0.45, width=1.25];
  CONCERNER [shape=box, style="filled,rounded", fillcolor="#FBF0E1", color="#C2660A",
             fontname="Helvetica", fontsize=11, label="CONCERNER", height=0.45, width=1.4];

  COMPTE -> EMETTRE [taillabel="0,n"];
  EMETTRE -> TRANSACTION [headlabel="1,1"];
  COMPTE -> RECEVOIR [taillabel="0,n"];
  RECEVOIR -> TRANSACTION [headlabel="1,1"];
  TRANSACTION -> CONCERNER [taillabel="0,n"];
  CONCERNER -> EVENEMENT [headlabel="0,1", color="#C2660A"];

  { rank=same; EMETTRE; RECEVOIR; }
}
