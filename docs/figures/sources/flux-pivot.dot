digraph FLUX {
  rankdir=LR;
  graph [fontname="Helvetica", bgcolor="white", nodesep=0.35, ranksep=1.1, pad=0.3];
  node [fontname="Helvetica", fontsize=11, shape=box, style="filled,rounded", penwidth=1.2, height=0.5, width=1.9];
  edge [color="#9A96C8", penwidth=1.3, arrowsize=0.7];

  subgraph cluster_src {
    label="SOURCES"; fontname="Helvetica"; fontsize=10; fontcolor="#6B7275";
    color="#D9D7E8"; style=rounded;
    s1 [label="PaySim", fillcolor="#FFFFFF", color="#9A96C8"];
    s2 [label="Référentiel clients", fillcolor="#FFFFFF", color="#9A96C8"];
    s3 [label="Journaux applicatifs", fillcolor="#FFFFFF", color="#9A96C8"];
  }

  bronze [label="BRONZE\nbrut, immuable", fillcolor="#F4F4F7", color="#9A96C8", height=0.8];
  silver [label="SILVER\nSCHÉMA PIVOT\nmodèle canonique", fillcolor="#E1F5EE", color="#0F6E56", penwidth=2, height=1.0, width=2.3];
  gold [label="GOLD\nschéma en étoile\nfaits + dimensions", fillcolor="#FBF0E1", color="#C2660A", height=1.0, width=2.1];

  subgraph cluster_usg {
    label="USAGES"; fontname="Helvetica"; fontsize=10; fontcolor="#6B7275";
    color="#D9D7E8"; style=rounded;
    u1 [label="Règles de détection", fillcolor="#FFFFFF", color="#9A96C8"];
    u2 [label="API", fillcolor="#FFFFFF", color="#9A96C8"];
    u3 [label="Tableau de bord", fillcolor="#FFFFFF", color="#9A96C8"];
  }

  s1 -> bronze; s2 -> bronze; s3 -> bronze;
  bronze -> silver [penwidth=2, color="#0F6E56"];
  silver -> gold [penwidth=2, color="#C2660A"];
  silver -> u1 [color="#0F6E56"];
  silver -> u2 [color="#0F6E56"];
  gold -> u3 [color="#C2660A"];
}
